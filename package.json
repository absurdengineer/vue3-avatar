{
  "name": "vue3-avatar",
  "version": "5.0.0",
  "license": "MIT",
  "description": "A lightweight, fully customizable, accessible, and SSR-safe user avatar component for Vue 3 and Nuxt. Supports initials, custom images, pixel-art generation (identicons), groups with overflow, and auto-contrast text. Perfect for user profiles, team displays, and comment sections.",
  "main": "dist/avatar.ssr.js",
  "browser": "dist/avatar.esm.js",
  "module": "dist/avatar.esm.js",
  "unpkg": "dist/avatar.min.js",
  "types": "dist/types/entry.esm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/entry.esm.d.ts",
      "import": "./dist/avatar.esm.js",
      "require": "./dist/avatar.ssr.js"
    },
    "./nuxt": {
      "types": "./dist/types/nuxt-module.d.ts",
      "import": "./dist/nuxt/module.mjs",
      "require": "./dist/nuxt/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*",
    "src/**/*.vue"
  ],
  "sideEffects": false,
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve dev/serve.js",
    "prebuild": "rimraf ./dist",
    "build": "cross-env NODE_ENV=production rollup --config build/rollup.config.js && npm run build:nuxt && npm run build:types",
    "build:ssr": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format cjs",
    "build:es": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format es",
    "build:unpkg": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format iife",
    "build:nuxt": "node build/copy-nuxt-module.js",
    "build:types": "vue-tsc -p tsconfig.build.json && node build/copy-types.js",
    "test": "vitest",
    "test:visual": "vitest --run --config vitest.visual.config.mts",
    "test:visual:update": "cross-env UPDATE_SNAPSHOTS=1 vitest --run --config vitest.visual.config.mts",
    "test:visual:headed": "cross-env VISUAL_HEADED=1 vitest --run --config vitest.visual.config.mts",
    "test:all": "npm run typecheck && npm test -- --run && npm run test:visual",
    "pretest:visual": "playwright install chromium",
    "size": "node build/check-size.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@babel/core": "^7.14.6",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-typescript": "^7.29.7",
    "@nuxt/kit": "^3.14.0",
    "@rollup/plugin-alias": "^3.1.2",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-replace": "^2.4.2",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/babel-preset-app": "^4.5.15",
    "@vue/cli-plugin-babel": "^4.5.13",
    "@vue/cli-service": "^4.5.13",
    "@vue/compiler-sfc": "^3.0.11",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "jsdom": "^27.3.0",
    "minimist": "^1.2.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.2.10",
    "rimraf": "^3.0.2",
    "rollup": "^2.52.8",
    "rollup-plugin-postcss": "^4.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-vue": "^6.0.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.15",
    "vue": "^3.0.5",
    "vue-tsc": "^2.1.0"
  },
  "peerDependencies": {
    "vue": "^3.0.5"
  },
  "engines": {
    "node": ">=12"
  },
  "keywords": [
    "vue",
    "vue3",
    "avatar",
    "vue3-avatar",
    "user-avatar",
    "profile-picture",
    "identicon",
    "initials",
    "pixel-art",
    "component",
    "ui",
    "tooltip",
    "badge",
    "status-indicator",
    "nuxt",
    "nuxt-module",
    "ssr",
    "typescript",
    "accessible",
    "a11y",
    "vuejs"
  ],
  "homepage": "https://github.com/absurdengineer/vue3-avatar#readme",
  "bugs": {
    "url": "https://github.com/absurdengineer/vue3-avatar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absurdengineer/vue3-avatar.git"
  }
}
